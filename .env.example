# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB CONFIGURATION FOR REPOSITORY SYNC AND CODE PUSHES:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PRIVY: alternative auth (email / social / wallet). Set this when Firebase's
# auth/unauthorized-domain error blocks Google sign-in on a deployed domain.
VITE_PRIVY_APP_ID=

# Override the Gemini model id (default: gemini-2.5-flash).
GEMINI_MODEL=

# Stripe (server-only — never VITE_ prefixed).
STRIPE_SECRET_KEY=
# A single Stripe Price ID for the default plan, or per-plan overrides:
STRIPE_PRICE_ID=
# Optional: per-plan price overrides (STRIPE_PRICE_ID_<PLAN_KEY>)
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=

# Crypto subscription — USDC receiving address & chain.
DEVIBE_USDC_RECEIVER=
DEVIBE_CHAIN=base   # base | polygon | ethereum

# FIREBASE: optional env-var overrides for the values in
# firebase-applet-config.json. Useful when deploying to a different Firebase
# project without editing source. After changing the project, also add the
# deployment origin at:
#   Firebase Console -> Authentication -> Settings -> Authorized domains
# Otherwise Google sign-in returns auth/unauthorized-domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
