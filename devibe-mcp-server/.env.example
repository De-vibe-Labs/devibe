# ---------------------------------------------------------------------------
# Devibe MCP Server — environment configuration
# Copy to .env and fill in. Never commit the populated .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Auth ----------------------------------------------------------------------
# Static API keys (comma-separated) accepted as `Authorization: Bearer <key>`.
# Use for service-to-service / local development.
DEVIBE_API_KEYS=dev-local-key

# Clerk (optional) — when set, Clerk session JWTs are accepted as bearer tokens.
CLERK_JWKS_URL=
CLERK_ISSUER=

# Supabase Auth (optional alternative to Clerk)
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=

# Database ------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devibe

# Redis / BullMQ ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# AI ------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude / Anthropic — powers mobile app generation with cost-tiered model
# escalation (Haiku 4.5 -> Sonnet 4.6 -> Opus 4.7; lesser models tried first).
ANTHROPIC_API_KEY=

# GitHub --------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Stripe (marketplace escrow / payments) ------------------------------------
STRIPE_SECRET_KEY=

# Deployment providers ------------------------------------------------------
VERCEL_TOKEN=
RAILWAY_TOKEN=
FLY_API_TOKEN=

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
